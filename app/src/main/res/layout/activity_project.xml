<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Back arrow, avatars and Invite. The avatars and Invite are UI only. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_back_circle"
            android:clickable="true"
            android:contentDescription="Back to projects"
            android:focusable="true"
            android:gravity="center"
            android:text="&#8592;"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="-10dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/avatar_one"
            android:gravity="center"
            android:text="JD"
            android:textColor="@color/card_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="-10dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/avatar_two"
            android:gravity="center"
            android:text="AL"
            android:textColor="@color/card_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/avatar_three"
            android:gravity="center"
            android:text="MK"
            android:textColor="@color/card_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_invite_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="7dp"
            android:text="Invite"
            android:textColor="@color/card_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProjectTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tag_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/tag_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Scrollable so the four labels are never clipped or shrunk. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        app:tabIndicatorColor="@color/blue_primary"
        app:tabIndicatorHeight="3dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="16dp"
        app:tabPaddingStart="16dp"
        app:tabSelectedTextColor="@color/blue_primary"
        app:tabTextAppearance="@style/TaskFlowTabText"
        app:tabTextColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/home_background" />
</LinearLayout>
